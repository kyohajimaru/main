---
const navItems = [
  { href: '/about/', label: 'About' },
  { href: '/service/', label: 'Service' },
  { href: '/flow/', label: 'Flow' },
  { href: '/works/', label: 'Works' },
  { href: '/column/', label: 'Column' },
  { href: '/contact/', label: 'Contact' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a class="site-logo" href="/">
          <span class="site-logo__main">きょうはじまる</span>
          <span class="site-logo__sub">web support for small shops</span>
        </a>
        <p>個人サロンや小さなお店のWebまわりを、相談から制作・運用までやさしく整えます。</p>
      </div>
      <nav aria-label="フッターメニュー">
        <ul class="site-footer__nav">
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="copyright">&copy; 2026 きょうはじまる</p>
  </div>
</footer>
