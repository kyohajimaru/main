---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const columns = await getCollection('column');
  return columns
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(entry.data.date);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="page-hero">
      <div class="container">
        <div class="card__meta">
          <time datetime={entry.data.date.toISOString()}>{date}</time>
          <span class="tag">{entry.data.category}</span>
        </div>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
      </div>
    </header>
    <div class="article">
      <div class="container article__body">
        <Content />
        <p><Button href="/column/" variant="secondary">コラム一覧へ戻る</Button></p>
      </div>
    </div>
  </article>
</BaseLayout>
